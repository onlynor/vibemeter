# ===== 数据源 Cookie（可选，仅从环境变量读取）=====
#
# 用法：复制本文件为 .env 再填值 —— 应用 load_dotenv() 加载的是 .env，
#       填在本文件里不会生效。本文件受 git 跟踪，别把真实 Cookie 写这里。
#           cp .env.example .env
#
# 这些 Cookie 只在进程内使用：不写数据库、不落盘、重启即失效，
# 与 LLM 配置一致的"不留痕"口径。留空时各平台仍会尝试匿名访问。
#
# 豆瓣：匿名即可读公开短评，Cookie 仅用于提升可读分页深度。
DOUBAN_COOKIE=
#
# 贴吧：匿名即可读公开楼层，Cookie 仅用于提升稳定性。
TIEBA_COOKIE=
#
# B站：匿名通常可用，但评论接口 -412 风控已常态化。
#      登录 www.bilibili.com 后从 开发者工具 > Application > Cookies
#      复制整段 Cookie，可绕过 -412。
BILIBILI_COOKIE=
#
# 微博：必填。微博公开搜索已强制登录态，未配置时该数据源直接不可用。
#      登录 m.weibo.cn 后复制整段 Cookie（至少需包含 SUB 字段）。
WEIBO_COOKIE=
#
# 知乎：匿名访问已被封死（搜索接口恒 400、回答接口 403）。
#      未配置时知乎只能退回"热榜里命中关键词的话题"，量很小；
#      配置后才能按关键词搜索回答与评论。
#      需要整段 Cookie（至少含 z_c0、d_c0、__zse_ck）。
ZHIHU_COOKIE=

# ===== 检索 / 采集调优（可选，全部有默认值）=====
#
# 默认值写在 backend/app/config.py，这里留空或整段删掉都不影响运行。
# 网络环境差（容器出网慢、跨运营商）时把时限调大，本机调试想快点就调小。
#
# 单个搜索引擎的检索时限（秒），超时只淘汰它自己，其余引擎照常返回
# VIBE_SEARCH_TIMEOUT=12
# 百度预热（拿 BAIDUID）的独立时限（秒），必须远小于上面的检索时限
# VIBE_SEARCH_WARMUP_TIMEOUT=6
# 预热 Cookie 在进程内复用多久（秒），期间不再重复打首页
# VIBE_SEARCH_COOKIE_TTL=900
# 单引擎取数上限 / 合并去重后的总量上限
# VIBE_SEARCH_LIMIT=8
# VIBE_SEARCH_TOTAL_LIMIT=12
#
# 聚合采集：单源首批宽限（秒）、单源总时限（秒）、每次下发条数
# VIBE_CRAWL_FIRST_BATCH_TIMEOUT=8
# VIBE_CRAWL_SOURCE_DEADLINE=60
# VIBE_CRAWL_EMIT_CHUNK=40
# 数据源可用性探测的时限（秒）
# VIBE_CRAWL_PING_TIMEOUT=25
